# Create production-quality values with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
TOKEN_ENCRYPTION_KEY=
API_BEARER_TOKEN=

# Set this after Fly deploy. Include the same high-entropy WEBHOOK_SECRET query
# parameter in the public URL so Plaid can authenticate webhook delivery.
PLAID_WEBHOOK_URL=
WEBHOOK_SECRET=

# Fly.io persistent volume mount point. Use ./data/expenses.sqlite3 locally.
DATABASE_PATH=./data/expenses.sqlite3
